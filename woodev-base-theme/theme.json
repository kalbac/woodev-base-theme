{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "background",
					"name": "Background",
					"color": "var(--background)"
				},
				{
					"slug": "foreground",
					"name": "Foreground",
					"color": "var(--foreground)"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "var(--primary)"
				},
				{
					"slug": "primary-foreground",
					"name": "Primary Foreground",
					"color": "var(--primary-foreground)"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "var(--secondary)"
				},
				{
					"slug": "secondary-foreground",
					"name": "Secondary Foreground",
					"color": "var(--secondary-foreground)"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "var(--muted)"
				},
				{
					"slug": "muted-foreground",
					"name": "Muted Foreground",
					"color": "var(--muted-foreground)"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "var(--accent)"
				},
				{
					"slug": "accent-foreground",
					"name": "Accent Foreground",
					"color": "var(--accent-foreground)"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "var(--border)"
				},
				{
					"slug": "destructive",
					"name": "Destructive",
					"color": "var(--destructive)"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "var(--success)"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "var(--warning)"
				},
				{
					"slug": "sale",
					"name": "Sale",
					"color": "var(--sale)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Golos Text\", system-ui, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"IBM Plex Sans\", system-ui, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--primary)",
					"text": "var(--primary-foreground)"
				}
			}
		}
	}
}
