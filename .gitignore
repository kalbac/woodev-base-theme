# Dependencies
node_modules/
vendor/

# Build output (release artifact only, not tracked)
woodev-base-theme/assets/dist/

# Env / local
.env
.env.*
*.local
.wp-env.override.json

# Personal opencode config — holds live MCP credentials.
# Copy opencode.example.json and fill in your own keys.
opencode.json

# Tooling caches
.vite/
.phpunit.result.cache
.phpcs-cache
jscpd-report/
playwright-report/
test-results/

# Local-only handoff prompt
next-session-promt.md

# OS noise
Thumbs.db
.DS_Store

# Generated build intermediate (regenerate with `npm run tokens`)
src/css/tokens.generated.css
src/css/packs/
tests/integration/vendor/

# Playwright MCP scratch output
.playwright-mcp/

# Regenerated every tests/e2e-woo/global-setup.mjs run — never a source of truth.
tests/e2e-woo/.fixtures.json

# wp.org screenshot — generated by scripts/make-screenshot.mjs from a real,
# deliberately-seeded site. Not committed from e2e fixture content.
woodev-base-theme/screenshot.png

# Throwaway runners and configs written in the repo root because that is the
# only place they can resolve node_modules (a Playwright config outside the
# project cannot import @playwright/test, and the seed helpers shell out with
# process.cwd()). They exist for the length of one debugging loop; ignoring the
# suffix is what stops one being committed by accident.
*.tmp.mjs
