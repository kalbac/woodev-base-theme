includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 8
	# The WooCommerce layer is optional at runtime (Theme::boot() guards on
	# class_exists), but PHPStan still has to know what is_woocommerce(),
	# is_cart(), is_checkout() and is_account_page() are — without stubs it
	# reports every Woo conditional tag as function.notFound, which is eight
	# errors of pure noise that would train us to ignore the gate.
	#
	# The stub package is pinned to the same MAJOR.MINOR as the WooCommerce
	# version .wp-env.woo.json installs (10.9), so what PHPStan checks against
	# and what e2e-woo runs against do not drift apart. Bump both together.
	bootstrapFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	paths:
		- woodev-base-theme/functions.php
		- woodev-base-theme/inc
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		-
			# php-stubs/wordpress-stubs types WP_Customize_Manager::add_setting()'s
			# `default` array key (and the mirrored WP_Customize_Setting::$default
			# property) as `string` only. WP core enforces no such constraint:
			# WP_Customize_Setting::__construct() assigns $args['default'] verbatim,
			# with no cast. Our number controls (base_font_size, container_width)
			# intentionally keep an int default end to end, and our checkbox control
			# (color_scheme_toggle, M1-05) keeps a bool default end to end —
			# Settings::*_DEFAULT / Scheme's fallback, the resolvers, and
			# CustomizerTest's assertSame() all agree on the non-string type — so
			# this is a documented stub-precision gap, not a bug in our code.
			# F2 (front page completion) adds a third: front_promo_image via
			# add_media(), an attachment ID that stays an int end to end for the
			# same reason.
			message: '#^Parameter \#2 \$args of method WP_Customize_Manager::add_setting\(\) expects array#'
			path: woodev-base-theme/inc/Customizer/Customizer.php
			count: 3
